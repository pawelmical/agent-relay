{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "task-mailbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // One mailbox is the coordination point for both agents, so there is one
  // SQLite Durable Object class. OAuth clients and grants live in KV, not tasks.
  "durable_objects": {
    "bindings": [{ "name": "MAILBOX", "class_name": "Mailbox" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Mailbox"] }],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      // Replace this placeholder before `wrangler deploy`. See the README.
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000000"
    }
  ]
}
